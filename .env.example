# Environment variables - DO NOT COMMIT real values

# Database connection (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.neon.tech/dbname?sslmode=require

# Instance secret (generate with: openssl rand -hex 32)
PCP_INSTANCE_SECRET=replace-with-random-32-char-hex-string

# Application URL
PCP_APP_URL=http://localhost:3000

# Optional admin/recovery token (32+ characters). Leave unset for first-run browser token generation.
# PCP_ADMIN_TOKEN=replace-with-random-32-plus-char-token

# Casdoor OIDC sign-in (all six required; sign-in is disabled otherwise)
# PCP_OIDC_ISSUER=https://auth.example.com
# PCP_OIDC_CLIENT_ID=replace-with-casdoor-client-id
# PCP_OIDC_CLIENT_SECRET=replace-with-casdoor-client-secret
# PCP_OIDC_REDIRECT_URI=https://pcp.example.com/auth/callback
# PCP_OIDC_REQUIRED_GROUP=example-org/app-pcp
# PCP_OIDC_ADMIN_GROUP=example-org/admin-pcp

# Emergency only: re-enable the legacy admin-token UI login
# PCP_BREAK_GLASS_ADMIN_LOGIN=1
